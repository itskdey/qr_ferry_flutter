#!/bin/sh
set -e

APP_HOME=$(cd "${0%/*}" && pwd -P)
GRADLE_VERSION=8.11.1
CACHE_DIR="$APP_HOME/.gradle-wrapper"
GRADLE_HOME="$CACHE_DIR/gradle-$GRADLE_VERSION"

if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$CACHE_DIR"
  ZIP="$CACHE_DIR/gradle-$GRADLE_VERSION-bin.zip"
  URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"

  echo "Gradle $GRADLE_VERSION not cached; downloading..." >&2

  if command -v curl >/dev/null 2>&1; then
    curl -L --fail --retry 3 -o "$ZIP" "$URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP" "$URL"
  else
    echo "curl or wget is required to bootstrap Gradle." >&2
    exit 1
  fi

  unzip -q -o "$ZIP" -d "$CACHE_DIR"
fi

exec "$GRADLE_HOME/bin/gradle" "$@"
